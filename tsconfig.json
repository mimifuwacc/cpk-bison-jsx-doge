{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["examples/**/*.ts", "packages/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["build", "node_modules"]
}
